{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "lib": ["es5", "es6"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["global.d.ts", "src/"],
    "exclude": ["tests/", "lib/", "node_modules/", "coverage/", "reports/"],
    "watchOptions": {
        "excludeDirectories": ["lib/*"]
    }
}
